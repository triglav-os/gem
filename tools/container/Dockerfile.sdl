# Add GEM's browser runtime dependencies to the supplied SDL toolchain.
ARG GEM_TOOLCHAIN_IMAGE=wischner/gcc-x86_64-linux-sdl:1.3.0
FROM ${GEM_TOOLCHAIN_IMAGE}
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    libnss3 libatk-bridge2.0-0 libxdamage1 \
    && rm -rf /var/lib/apt/lists/*
