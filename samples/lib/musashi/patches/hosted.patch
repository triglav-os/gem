diff --git a/softfloat/softfloat-macros b/softfloat/softfloat-macros
index 5de9031..7acac6d 100644
--- a/softfloat/softfloat-macros
+++ b/softfloat/softfloat-macros
@@ -285,6 +285,16 @@ static inline void
      bits64 a0, bits64 a1, int16 count, bits64 *z0Ptr, bits64 *z1Ptr )
 {
 
+    /* GEM port derivative: define boundary shifts without C shift overflow. */
+    if ( (unsigned int) count >= 128 ) {
+        *z0Ptr = *z1Ptr = 0;
+        return;
+    }
+    if ( count >= 64 ) {
+        *z0Ptr = a1 << (count - 64);
+        *z1Ptr = 0;
+        return;
+    }
     *z1Ptr = a1<<count;
     *z0Ptr =
         ( count == 0 ) ? a0 : ( a0<<count ) | ( a1>>( ( - count ) & 63 ) );
