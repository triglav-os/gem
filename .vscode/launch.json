{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "GEM \u2014 Desktop",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/core/gemd",
            "cwd": "${workspaceFolder}",
            "args": [],
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "pipeTransport": {
                "pipeProgram": "bash",
                "pipeArgs": [
                    "${workspaceFolder}/tools/scripts/runtime.sh",
                    "exec",
                    "/bin/sh",
                    "-c"
                ],
                "pipeCwd": "${workspaceFolder}",
                "debuggerPath": "${workspaceFolder}/tools/scripts/sample_debugger.py"
            },
            "miDebuggerArgs": "-iex \"set debuginfod enabled off\"",
            "preLaunchTask": "Start GEM sample session",
            "postDebugTask": "Stop GEM sample session",
            "setupCommands": [
                {
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "text": "-gdb-set pagination off",
                    "ignoreFailures": true
                },
                {
                    "description": "Closing Rasta or Stop sends SIGTERM; let gemd shut down instead of pausing",
                    "text": "-interpreter-exec console \"handle SIGTERM nostop noprint pass\"",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
