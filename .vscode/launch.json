{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "GEM \u2014 all samples",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/core/gemd",
            "cwd": "${workspaceFolder}",
            "args": [],
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "${workspaceFolder}/tools/scripts/sample_debugger.py",
            "miDebuggerArgs": "-iex \"set debuginfod enabled off\"",
            "preLaunchTask": "Start GEM sample session",
            "postDebugTask": "Stop GEM sample session",
            "setupCommands": [
                {
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "text": "-gdb-set pagination off",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
