{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build GEM and samples",
            "type": "process",
            "command": "make",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "args": [
                "all"
            ]
        },
        {
            "label": "Start GEM sample session",
            "type": "process",
            "command": "make",
            "args": [
                "run",
                "DEBUG=1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "Stop GEM sample session",
            "type": "process",
            "command": "make",
            "args": [
                "stop"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
