{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build GEM and samples",
            "type": "process",
            "command": "${workspaceFolder}/tools/scripts/container.sh",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "GEM_CONTAINER_IMAGE": "wischner/gcc-x86_64-linux-sdl:1.3.0",
                    "GEM_CONTAINER_BUILD_DIR": "${workspaceFolder}/build/container-sdl",
                    "GEM_CONTAINER_OUTPUT_ROOT": "${workspaceFolder}/bin"
                }
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "args": [
                "all"
            ]
        },
        {
            "label": "Start GEM sample session",
            "type": "process",
            "command": "python3",
            "args": [
                "-B",
                "${workspaceFolder}/tools/scripts/sample_session.py",
                "start"
            ],
            "dependsOn": "Build GEM and samples",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "Stop GEM sample session",
            "type": "process",
            "command": "python3",
            "args": [
                "-B",
                "${workspaceFolder}/tools/scripts/sample_session.py",
                "stop"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
